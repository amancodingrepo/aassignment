# Required only for the chat loop. Ingest, calculators, the scope gate,
# signals and the confirm flow all run without it.
# Prefer Gemini. Anthropic still works if you set ANTHROPIC_API_KEY instead.
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional. Free-tier gemini-3.6-flash is 20 requests/day; the server
# falls back to gemini-3.5-flash-lite and siblings on 429.
# PARCELPILOT_MODEL=gemini-3.5-flash-lite
# PARCELPILOT_MODEL_FALLBACKS=gemini-3.5-flash,gemini-2.5-flash-lite
# SESSION_SECRET=dev-only-not-a-real-secret
# PARCELPILOT_DB=./var/parcelpilot.db
# PORT=8000
# On Railway: attach a volume at /data and keep PARCELPILOT_DB=/data/parcelpilot.db
